{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pantheon",
  "version": "0.1.0",
  "identifier": "app.pantheon.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pantheon",
        "width": 1100,
        "height": 720,
        "visible": false,
        "decorations": false
      },
      {
        "label": "splash",
        "title": "Pantheon",
        "url": "splash.html",
        "width": 440,
        "height": 300,
        "decorations": false,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
