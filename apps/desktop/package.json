{
  "name": "pantheon-desktop",
  "version": "0.1.0",
  "description": "Pantheon mod manager (Tauri + Solid)",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "panda codegen && panda cssgen --outfile src/styled-system/styles.css && vite",
    "build": "panda codegen && panda cssgen --outfile src/styled-system/styles.css && vite build",
    "serve": "vite preview",
    "tauri": "tauri dev",
    "panda:codegen": "panda codegen",
    "panda:cssgen": "panda cssgen --outfile src/styled-system/styles.css"
  },
  "license": "MIT",
  "dependencies": {
    "@ark-ui/solid": "^5.35.0",
    "@pandacss/dev": "^1.9.1",
    "@tanstack/solid-virtual": "^3.13.23",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "i18next": "^25.10.10",
    "lucide-solid": "^1.7.0",
    "solid-i18next": "^0.0.3",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-solid": "^2.11.0"
  }
}
